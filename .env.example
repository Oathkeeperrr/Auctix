# ---------------------------------------------------------------------------
# AuctiX environment. Copy this file to .env before running docker compose.
#   cp .env.example .env
# Never commit the real .env.
# ---------------------------------------------------------------------------

# --- PostgreSQL
POSTGRES_DB=auctix
POSTGRES_USER=auctix
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=5432

# --- Redis
REDIS_PORT=6379

# --- Security
# Must be at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MINUTES=720

# --- Ports
HTTP_PORT=80
BACKEND_PORT=8080

# --- Application behaviour
# Origin patterns allowed to call the API. "[*]" is a port wildcard, so this keeps working
# whatever HTTP_PORT you choose. Narrow it to your real origin in production.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:[*],http://127.0.0.1,http://127.0.0.1:[*]
ANTI_SNIPE_ENABLED=true
ANTI_SNIPE_WINDOW_SECONDS=30
ANTI_SNIPE_EXTENSION_SECONDS=30
BID_RATE_LIMIT_MAX=10
LOG_LEVEL_AUCTIX=INFO

# --- Demo data
# Loads demo users and auctions the first time the database is empty.
AUCTIX_SEED_ENABLED=true
AUCTIX_SEED_PASSWORD=Password123!
